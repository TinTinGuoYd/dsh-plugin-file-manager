{
  "name": "dsh-plugin-file-manager",
  "version": "0.2.0",
  "description": "Docked file manager panel for the DSH web UI: browse the current workspace, preview text files, and open files with the operating system's default application.",
  "keywords": [
    "dsh",
    "deepseek-harness",
    "dsh-plugin",
    "file-manager",
    "file-explorer",
    "web-ui",
    "workspace"
  ],
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "README.zh.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "dsh": {
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-ui-primitives"
      ],
      "platform": "web"
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "check": "node --check lib/index.js && node --check lib/client.js"
  }
}
